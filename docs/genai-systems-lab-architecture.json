  "cards": [
    {
      "dot": "cyan",
      "title": "Interactive Path",
      "items": [
        "The portfolio calls the secured FastAPI surface over REST and SSE",
        "The shared runner resolves one project and invokes its run() contract",
        "Project workflows share provider routing, usage, and cost telemetry"
      ]
    },
    {
      "dot": "violet",
      "title": "Durable Queue Path",
      "items": [
        "Authenticated job creation enqueues JSON-serialized work in Redis",
        "An RQ worker consumes the encrypted, expiring BYOK handoff",
        "Job state and outputs remain owner-scoped in relational storage"
      ]
    },
    {
      "dot": "emerald",
      "title": "Operational Boundaries",
      "items": [
        "BYOK credentials stay request-scoped or use the bounded queue handoff",
        "PostgreSQL is the production store; SQLite keeps local setup zero-config",
        "Langfuse and OpenTelemetry are opt-in and fail open as no-ops"
      ]
    }
  ]
